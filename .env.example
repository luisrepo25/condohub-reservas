APP_NAME=CondoHub-Reservas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8082

LOG_CHANNEL=stderr
LOG_LEVEL=debug

# Base propia del servicio (infra/postgres/init). Si el 5432 de tu máquina lo ocupa otro PostgreSQL, usa 5433
# (POSTGRES_PORT=5433 en el compose).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=reservas
DB_USERNAME=reservas
DB_PASSWORD=reservas_dev

# No hay usuarios ni sesiones propias: la identidad es siempre un JWT de Keycloak.
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

KEYCLOAK_ISSUER=http://localhost:8180/realms/condohub
# KEYCLOAK_JWKS=   (por defecto: <issuer>/protocol/openid-connect/certs)
# Gestión (R4: morosidad), por el gateway. En Docker: http://gateway:8000/gestion/graphql
GESTION_GRAPHQL_URL=http://localhost:8080/gestion/graphql
# GESTION_TIMEOUT_SEGUNDOS=5
# GESTION_REINTENTOS=1
