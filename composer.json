{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "condohub/reservas",
    "type": "project",
    "description": "Reservas de áreas comunes de CondoHub y orquestador de la saga de reserva",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.0",
        "laravel/framework": "^12.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.13",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "CondoHub\\Reservas\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "test": "pest",
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
